# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/
env/

# ── Flask / 运行时数据 ─────────────────────────────────
instance/
logs/
.flaskenv
.env

# ── 平台生成产物（可由平台重新生成/同步，不入库） ─────
product/
nginx_configs/
recycle/
output/

# ── 敏感 / 个人配置（不入库） ───────────────────────────
config/config.yaml
config/config.local.yaml
settings_insert.sql
.reasonix/
reasonix.toml

# ── Go（Agent 构建产物） ───────────────────────────────
agent/dist/
agent/*.exe
agent/*.test
*.exe

# ── IDE / 编辑器 ───────────────────────────────────────
.idea/
.vscode/
*.iml

